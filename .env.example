# Copy to .env and fill in real values. Never commit .env.

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Other browser origins allowed to call the API (comma-separated). Leave empty: the app and the API
# share one origin (production: one domain; development: the Vite proxy). 'null' is always rejected.
CORS_ORIGINS=
# Behind nginx on the same server: loopback (docs/DEPLOYMENT.md). Leave empty without a proxy.
TRUST_PROXY=

# ─── PostgreSQL Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asms
DB_USER=asms_user
DB_PASSWORD=change-me

# ─── JWT Secrets ──────────────────────────────────────
# Use long random values, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Access tokens are fixed at 15 minutes in code; JWT_EXPIRES_IN is no longer read.
JWT_REFRESH_EXPIRES_IN=7d

# ─── School Info ──────────────────────────────────────
SCHOOL_NAME=Äbugida School
# Amharic school name, printed next to SCHOOL_NAME on ID cards (empty: none)
SCHOOL_NAME_AM=አቡጊዳ ትምህርት ቤት
SCHOOL_CODE=ASMS

# Folder for uploaded documents (default: uploads/documents under the working directory)
# UPLOAD_DIR=C:/asms/uploads/documents
