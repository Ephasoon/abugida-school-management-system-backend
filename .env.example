# Copy to .env and fill in real values. Never commit .env.

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated, no spaces needed).
# 'null' is always rejected. If unset, localhost/127.0.0.1 ports 5500-5501 are used.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── PostgreSQL Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asms
DB_USER=asms_user
DB_PASSWORD=change-me

# ─── JWT Secrets ──────────────────────────────────────
# Use long random values, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Access tokens are fixed at 15 minutes in code; JWT_EXPIRES_IN is no longer read.
JWT_REFRESH_EXPIRES_IN=7d

# ─── School Info ──────────────────────────────────────
SCHOOL_NAME=Äbugida School
SCHOOL_CODE=ASMS
ACADEMIC_YEAR=2024/2025
